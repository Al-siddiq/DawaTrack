CI_ENVIRONMENT = development
app.baseURL = 'http://localhost:8080/'
app.forceGlobalSecureRequests = false
DAWATRACK_DEPLOYMENT_ID = 'local-development'

database.default.hostname = localhost
database.default.database = dawatrack
database.default.username = dawatrack_app
database.default.password = 'replace-with-a-local-secret'
database.default.DBDriver = MySQLi
database.default.port = 3306
database.default.charset = utf8mb4
database.default.DBCollat = utf8mb4_0900_ai_ci
DAWATRACK_PLATFORM_DOMAIN = 'dawatrack.local'
