{
  "private": true,
  "scripts": {
    "build:css": "sass --style=compressed --no-source-map resources/css/app.scss public/assets/css/app.css",
    "build:assets": "node scripts/build-frontend-assets.mjs",
    "build": "npm run build:css && npm run build:assets",
    "ui:reference": "node scripts/build-ui-reference.mjs",
    "ui:preview": "node scripts/serve-ui-reference.mjs",
    "ui:release": "node scripts/build-ui-release-manifest.mjs",
    "ui:release:check": "node scripts/build-ui-release-manifest.mjs --check"
  },
  "devDependencies": {
    "bootstrap": "5.3.8",
    "bootstrap-icons": "1.13.2",
    "dexie": "4.2.1",
    "sass": "1.93.2",
    "vue": "3.5.44"
  }
}
